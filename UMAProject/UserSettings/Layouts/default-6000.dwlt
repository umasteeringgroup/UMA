    [\n        \"code\",\n        \"HLSL\"\n    ],\n    \"m_Precision\": 0,\n   
    \"m_PreviewExpanded\": false,\n    \"m_DismissedVersion\": 0,\n    \"m_PreviewMode\":
    0,\n    \"m_CustomColors\": {\n        \"m_SerializableColors\": []\n    },\n   
    \"m_SourceType\": 1,\n    \"m_FunctionName\": \"MainLightDir\",\n    \"m_FunctionSource\":
    \"\",\n    \"m_FunctionSourceUsePragmas\": true,\n    \"m_FunctionBody\": \"
    #ifdef SHADERGRAPH_PREVIEW\\r\\n    Dir = float3(0.5,0.5,0);\\r\\n    Color =
    float3(1,1,1);\\n    //Intensity = 1;\\n    //Shadow = 1;\\n#else\\r               
    \\n    Light mainLight = GetMainLight();\\n    Dir = normalize(mainLight.direction);\\r\\n   
    Color = max(0, mainLight.color);\\n    //Intensity = length(Color);\\n    //Shadow
    = mainLight.shadowAttenuation;\\n#endif\\n\\n\"\n}\n\n{\n    \"m_SGVersion\":
