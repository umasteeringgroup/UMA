    false\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n   
    \"m_ObjectId\": \"7ad65831e956444e80b86af20d108ea6\",\n    \"m_Title\": \"\",\n   
    \"m_Content\": \"We multiply base texture with all 3 colors (Base, Root, Tip)
    separately and then lerp with a Root/Tip masks. This way we can achieve white
    tips over the colored hair. We can also disable root&tip colorization and just
    keep everything with a single Base color.\",\n    \"m_TextSize\": 0,\n    \"m_Theme\":
    0,\n    \"m_Position\": {\n        \"serializedVersion\": \"2\",\n        \"x\":
    -2355.0,\n        \"y\": -272.0,\n        \"width\": 429.0,\n        \"height\":
    153.0\n    },\n    \"m_Group\": {\n        \"m_Id\": \"5c770ba6f80942c08f46193212b1419b\"\n   
    }\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.Vector1MaterialSlot\",\n   
