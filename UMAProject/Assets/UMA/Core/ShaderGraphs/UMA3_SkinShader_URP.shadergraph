    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLightDir",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": " #ifdef SHADERGRAPH_PREVIEW\r\n    Dir = float3(0.5,0.5,0);\r\n    Color = float3(1,1,1);\n    //Intensity = 1;\n    //Shadow = 1;\n#else\r                \n    Light mainLight = GetMainLight();\n    Dir = normalize(mainLight.direction);\r\n    Color = max(0, mainLight.color);\n    //Intensity = length(Color);\n    //Shadow = mainLight.shadowAttenuation;\n#endif\n\n"
}

