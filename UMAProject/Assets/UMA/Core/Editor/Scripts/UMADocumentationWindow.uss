.uma-document-open-button {
    flex-grow: 1;
    -unity-text-align: middle-left;
    min-height: 22px;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 2px;
    font-size: 13px;
}

.uma-document-dragging {
    opacity: 0.7;
}

.uma-document-drop-target {
    border-top-width: 2px;
    border-top-color: rgb(58, 121, 187);
}
