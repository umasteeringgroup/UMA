// Real-time ETC2 RGB8 and ETC2 RGBA8 (EAC alpha) encoders for UMA generated
// textures on devices without BC formats. The colour encoder uses the
// individual and differential modes that ETC2 shares with ETC1; the alpha
// encoder searches every EAC table with a fitted multiplier.
#pragma kernel CompressETC2RGB
#pragma kernel CompressETC2RGBA
#pragma multi_compile __ UMA_BLOCKS_TO_BUFFER

#include "UMATextureCompressCommon.hlsl"

// Intensity modifiers of the eight colour tables: small and large step.
static const float kColorModifiers[16] =
{
    2.0, 8.0,
    5.0, 17.0,
    9.0, 29.0,
    13.0, 42.0,
    18.0, 60.0,
    24.0, 80.0,
    33.0, 106.0,
    47.0, 183.0
};

// Negative half of the sixteen EAC tables. Index 0..3 is -value, index 4..7
// is value - 1 of the same row.
static const float kAlphaModifiers[64] =
{
    3.0, 6.0, 9.0, 15.0,
    3.0, 7.0, 10.0, 13.0,
    2.0, 5.0, 8.0, 13.0,
    2.0, 4.0, 6.0, 13.0,
    3.0, 6.0, 8.0, 12.0,
    3.0, 7.0, 9.0, 11.0,
    4.0, 7.0, 8.0, 11.0,
    3.0, 5.0, 8.0, 11.0,
    2.0, 6.0, 8.0, 10.0,
    2.0, 5.0, 8.0, 10.0,
    2.0, 4.0, 8.0, 10.0,
    2.0, 5.0, 7.0, 10.0,
    3.0, 4.0, 7.0, 10.0,
    1.0, 2.0, 3.0, 10.0,
    4.0, 6.0, 8.0, 9.0,
    3.0, 5.0, 7.0, 9.0
};

// ETC blocks are big-endian byte streams; the outputs are little-endian words.
uint SwapBytes(uint v)
{
    return (v << 24) | ((v & 0x0000FF00u) << 8) | ((v >> 8) & 0x0000FF00u) | (v >> 24);
}

float AlphaModifier(int table, int index)
{
    float negative = kAlphaModifiers[table * 4 + (index & 3)];
    return index < 4 ? -negative : negative - 1.0;
}

// texels are 0..255, in row order (index = y * 4 + x).
uint2 EncodeColorBlock(float3 texels[16])
{
    // Sub-block layout: flip 0 = left and right halves, flip 1 = top and bottom.
    float3 sumLeft = 0.0, sumRight = 0.0, sumTop = 0.0, sumBottom = 0.0;
    float sumSquares = 0.0;
    int i;
    for (i = 0; i < 16; i++)
    {
        float3 c = texels[i];
        sumSquares += dot(c, c);
        if ((i & 3) < 2) sumLeft += c; else sumRight += c;
        if ((i >> 2) < 2) sumTop += c; else sumBottom += c;
    }
    // Sum of squared deviations from the two sub-block means, for each layout.
    float errorNoFlip = sumSquares - (dot(sumLeft, sumLeft) + dot(sumRight, sumRight)) * 0.125;
    float errorFlip = sumSquares - (dot(sumTop, sumTop) + dot(sumBottom, sumBottom)) * 0.125;
    bool flip = errorFlip < errorNoFlip;
    float3 mean0 = (flip ? sumTop : sumLeft) * 0.125;
    float3 mean1 = (flip ? sumBottom : sumRight) * 0.125;

    // Differential mode (5 bits + 3 bit signed delta) when the two base
    // colours are close enough, individual mode (4 + 4 bits) otherwise.
    int3 q0 = (int3)floor(mean0 * (31.0 / 255.0) + 0.5);
    int3 q1 = (int3)floor(mean1 * (31.0 / 255.0) + 0.5);
    int3 delta = q1 - q0;
    bool differential = all(delta >= -4) && all(delta <= 3);
    float3 base0, base1;
    uint header;
    if (differential)
    {
        base0 = (float3)((q0 << 3) | (q0 >> 2));
        base1 = (float3)((q1 << 3) | (q1 >> 2));
        uint3 d = (uint3)(delta & 7);
        header = ((uint)q0.r << 27) | (d.r << 24) | ((uint)q0.g << 19) | (d.g << 16) | ((uint)q0.b << 11) | (d.b << 8) | 2u;
    }
    else
    {
        q0 = (int3)floor(mean0 * (15.0 / 255.0) + 0.5);
        q1 = (int3)floor(mean1 * (15.0 / 255.0) + 0.5);
        base0 = (float3)((q0 << 4) | q0);
        base1 = (float3)((q1 << 4) | q1);
        header = ((uint)q0.r << 28) | ((uint)q1.r << 24) | ((uint)q0.g << 20) | ((uint)q1.g << 16) | ((uint)q0.b << 12) | ((uint)q1.b << 8);
    }
    if (flip) header |= 1u;

    float bestError0 = 1e30, bestError1 = 1e30;
    uint bestTable0 = 0u, bestTable1 = 0u;
    uint bestMsb0 = 0u, bestMsb1 = 0u, bestLsb0 = 0u, bestLsb1 = 0u;
    for (int table = 0; table < 8; table++)
    {
        float small = kColorModifiers[table * 2];
        float large = kColorModifiers[table * 2 + 1];
        float error0 = 0.0, error1 = 0.0;
        uint msb0 = 0u, msb1 = 0u, lsb0 = 0u, lsb1 = 0u;
        for (i = 0; i < 16; i++)
        {
            int x = i & 3;
            int y = i >> 2;
            bool second = flip ? (y >= 2) : (x >= 2);
            float3 base = second ? base1 : base0;
            float3 c = texels[i];

            // Selector bits: msb = negative, lsb = large step.
            float3 d = clamp(base + small, 0.0, 255.0) - c;
            float best = dot(d, d);
            uint selector = 0u;
            d = clamp(base + large, 0.0, 255.0) - c;
            float e = dot(d, d);
            if (e < best) { best = e; selector = 1u; }
            d = clamp(base - small, 0.0, 255.0) - c;
            e = dot(d, d);
            if (e < best) { best = e; selector = 2u; }
            d = clamp(base - large, 0.0, 255.0) - c;
            e = dot(d, d);
            if (e < best) { best = e; selector = 3u; }

            // ETC numbers the texels in column order.
            uint bit = 1u << (uint)(x * 4 + y);
            if (second)
            {
                error1 += best;
                if ((selector & 2u) != 0u) msb1 |= bit;
                if ((selector & 1u) != 0u) lsb1 |= bit;
            }
            else
            {
                error0 += best;
                if ((selector & 2u) != 0u) msb0 |= bit;
                if ((selector & 1u) != 0u) lsb0 |= bit;
            }
        }
        if (error0 < bestError0) { bestError0 = error0; bestTable0 = (uint)table; bestMsb0 = msb0; bestLsb0 = lsb0; }
        if (error1 < bestError1) { bestError1 = error1; bestTable1 = (uint)table; bestMsb1 = msb1; bestLsb1 = lsb1; }
    }

    header |= (bestTable0 << 5) | (bestTable1 << 2);
    uint selectors = ((bestMsb0 | bestMsb1) << 16) | (bestLsb0 | bestLsb1);
    return uint2(SwapBytes(header), SwapBytes(selectors));
}

// alpha is 0..255, in row order.
uint2 EncodeAlphaBlock(float alpha[16])
{
    float low = alpha[0];
    float high = alpha[0];
    int i;
    for (i = 1; i < 16; i++)
    {
        low = min(low, alpha[i]);
        high = max(high, alpha[i]);
    }

    uint bestBase = (uint)low;
    uint bestMultiplier = 1u;
    uint bestTable = 13u;
    uint hi = 0u;
    uint lo = 0u;
    if (high - low < 0.5)
    {
        // Constant block: table 13 has a zero modifier at index 4.
        for (i = 0; i < 16; i++)
        {
            int shift = 45 - 3 * i;
            if (shift >= 32) hi |= 4u << (uint)(shift - 32);
            else
            {
                lo |= 4u << (uint)shift;
                if (shift > 29) hi |= 4u >> (uint)(32 - shift);
            }
        }
    }
    else
    {
        float bestError = 1e30;
        float center = (low + high) * 0.5;
        float bestBaseValue = low;
        float bestMultiplierValue = 1.0;
        int table;
        for (table = 0; table < 16; table++)
        {
            // The table spans -negMax .. negMax - 1.
            float negMax = kAlphaModifiers[table * 4 + 3];
            float multiplier = clamp(floor((high - low) / (2.0 * negMax - 1.0) + 0.5), 1.0, 15.0);
            float base = clamp(floor(center + multiplier * 0.5 + 0.5), 0.0, 255.0);
            float error = 0.0;
            for (i = 0; i < 16; i++)
            {
                float best = 1e30;
                for (int index = 0; index < 8; index++)
                {
                    float value = clamp(base + multiplier * AlphaModifier(table, index), 0.0, 255.0);
                    float e = (value - alpha[i]) * (value - alpha[i]);
                    best = min(best, e);
                }
                error += best;
            }
            if (error < bestError)
            {
                bestError = error;
                bestTable = (uint)table;
                bestBaseValue = base;
                bestMultiplierValue = multiplier;
            }
        }
        bestBase = (uint)bestBaseValue;
        bestMultiplier = (uint)bestMultiplierValue;

        for (i = 0; i < 16; i++)
        {
            float best = 1e30;
            uint selected = 0u;
            for (int index = 0; index < 8; index++)
            {
                float value = clamp(bestBaseValue + bestMultiplierValue * AlphaModifier((int)bestTable, index), 0.0, 255.0);
                float e = (value - alpha[i]) * (value - alpha[i]);
                if (e < best) { best = e; selected = (uint)index; }
            }
            // Column order, first texel in the highest bits of the 48.
            int texel = (i & 3) * 4 + (i >> 2);
            int shift = 45 - 3 * texel;
            if (shift >= 32) hi |= selected << (uint)(shift - 32);
            else
            {
                lo |= selected << (uint)shift;
                if (shift > 29) hi |= selected >> (uint)(32 - shift);
            }
        }
    }

    hi |= (bestBase << 24) | (bestMultiplier << 20) | (bestTable << 16);
    return uint2(SwapBytes(hi), SwapBytes(lo));
}

[numthreads(8, 8, 1)]
void CompressETC2RGB(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_BlockCount.x || id.y >= (uint)_BlockCount.y) return;
    float4 texels[16];
    LoadBlock(id.xy, texels);
    float3 colors[16];
    for (int i = 0; i < 16; i++) colors[i] = floor(texels[i].rgb * 255.0 + 0.5);
    StoreBlock8(id.xy, EncodeColorBlock(colors));
}

[numthreads(8, 8, 1)]
void CompressETC2RGBA(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_BlockCount.x || id.y >= (uint)_BlockCount.y) return;
    float4 texels[16];
    LoadBlock(id.xy, texels);
    float3 colors[16];
    float alpha[16];
    for (int i = 0; i < 16; i++)
    {
        colors[i] = floor(texels[i].rgb * 255.0 + 0.5);
        alpha[i] = floor(texels[i].a * 255.0 + 0.5);
    }
    StoreBlock16(id.xy, uint4(EncodeAlphaBlock(alpha), EncodeColorBlock(colors)));
}
