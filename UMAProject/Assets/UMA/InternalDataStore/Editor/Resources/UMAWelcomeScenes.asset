%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5045c231c906a1a439a91fb82688bd29, type: 3}
  m_Name: UMAWelcomeScenes
  m_EditorClassIdentifier: 
  umaScenes:
  - sceneName: U3 Character Creator
    shortName: Character Creator
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-Character Creator.unity
    sceneTexture: {fileID: 2800000, guid: 0b712bfa22a0a3a4d8a000de89caa9e4, type: 3}
    sceneDescription: A complete UMA character editor showing races, wardrobe, DNA,
      and shared colors.
  - sceneName: U3 Generating Random Characters
    shortName: Random Characters
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-Generating Random Characters.unity
    sceneTexture: {fileID: 2800000, guid: 0461740b7685e2b48a85e91e005c2dc6, type: 3}
    sceneDescription: This sample shows how to use UMARandomAvatar to create random
      characters in the scene.
  - sceneName: U3 Car Scene
    shortName: UMA Car
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-Car Scene.unity
    sceneTexture: {fileID: 2800000, guid: e325730323b430b45b28eb27534fc006, type: 3}
    sceneDescription: Shows how to use UMA to customize a non-humanoid avatars. In
      this case, a car.
  - sceneName: U3 Decals
    shortName: Decals
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-Decals.unity
    sceneTexture: {fileID: 0}
    sceneDescription: Demonstrates UMA decal overlays and runtime decal workflows.
  - sceneName: U3 Sandbox
    shortName: Sandbox
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-Sandbox.unity
    sceneTexture: {fileID: 0}
    sceneDescription: A general-purpose scene for experimenting with UMA characters
      and content.
  - sceneName: U3 Ragdolls and Shooting Example
    shortName: Ragdoll Physics
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-Ragdolls and Shooting Example.unity
    sceneTexture: {fileID: 2800000, guid: cb2cf481ae6480f4f92c0c37a60ea01b, type: 3}
    sceneDescription: This sample shows how to enable ragdoll physics, how to determine
      hit area, and how to change the character to ragdoll and back to a standard
      UMA.
  - sceneName: U3 Integrating with Timeline
    shortName: Integrating Timeline
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-Integrating with Timeline.unity
    sceneTexture: {fileID: 2800000, guid: ea7e142b30e2bf840a95a29090bad4d2, type: 3}
    sceneDescription: This example shows how to integrate UMA into Timeline, for
      creating scripted scenes with UMA deformations.
  - sceneName: U3 How to Equip Items
    shortName: Equip Items
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-How to equip items.unity
    sceneTexture: {fileID: 2800000, guid: e10b6bd4617793541a61856d200ce0e0, type: 3}
    sceneDescription: Shows how to equip and attach items to an UMA character.
  - sceneName: U3 How to Construct a DCA from Scratch
    shortName: How To Construct
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-How to Construct a DCA from scratch.unity
    sceneTexture: {fileID: 2800000, guid: 1726355a56d028f4ea74e009dcbf805a, type: 3}
    sceneDescription: How-To sample showing how to construct an UMA completely in
      code.
  - sceneName: U3 How to Construct and Load a DCA from a Prefab
    shortName: How To Prefab
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-How to Construct and load a DCA from a prefab.unity
    sceneTexture: {fileID: 2800000, guid: 1726355a56d028f4ea74e009dcbf805a, type: 3}
    sceneDescription: How-To sample shpwing how to create an UMA from a prefab that
      has already been configured.
  - sceneName: U3 How to Load and Save a DCA to a String
    shortName: How To Load/Save
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-How to Load and Save a DCA to a string.unity
    sceneTexture: {fileID: 2800000, guid: 1726355a56d028f4ea74e009dcbf805a, type: 3}
    sceneDescription: How-To sample that shows how to serialize an UMA to a string,
      and how to load that back in.
  - sceneName: U3 How to Use a Slider to Control DNA
    shortName: How To Use a Slider
    scenePath: Assets/UMA/SRP/Samples/Scenes/U3-How to Use a Slider to control DNA.unity
    sceneTexture: {fileID: 2800000, guid: 1726355a56d028f4ea74e009dcbf805a, type: 3}
    sceneDescription: How-To sample that shows how to use a slider to modify the
      DNA of an UMA.
