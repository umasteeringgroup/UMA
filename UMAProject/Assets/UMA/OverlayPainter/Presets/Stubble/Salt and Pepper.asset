  m_Name: Salt and Pepper
  m_EditorClassIdentifier: UMA.TexturePaint.Runtime::UMA.TexturePaint.TexturePaintMaterialPreset
  schemaVersion: 3
  presetId: f1e67c7c935c44009c8163fda35f5f7b
  revision: 1
  displayName: Salt and Pepper
  description: Natural curved stubble with coordinated roughness and subtle relief.
    Restrict to the beard/scalp using a layer or Control Mask. Facial growth follows
    UMA landmarks when available. Dimensions use a fixed 2K reference; changing output
    resolution preserves the groom.
