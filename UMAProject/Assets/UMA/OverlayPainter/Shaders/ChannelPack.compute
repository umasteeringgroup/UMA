#pragma kernel CSExtract
#pragma kernel CSPackChannels
#pragma kernel CSApplyNormalControl
#pragma kernel CSApplyPluginTile

Texture2D<float4> _Source;
Texture2D<float4> _Red;
Texture2D<float4> _Green;
Texture2D<float4> _Blue;
Texture2D<float4> _Alpha;
Texture2D<float4> _NormalBase;
Texture2D<float4> _NormalControl;
Texture2D<float4> _PluginSource;
Texture2D<float4> _PluginDestinationSource;
Texture2D<float4> _GeometryMask;
RWTexture2D<float4> _Destination;
int2 _TextureSize;
int2 _TileOffset;
int2 _DispatchSize;
int _Component;
int _Invert;
int _HasRed;
int _HasGreen;
int _HasBlue;
int _HasAlpha;
int _RedSourceComponent;
int _GreenSourceComponent;
int _BlueSourceComponent;
int _AlphaSourceComponent;
int _RedInvert;
int _GreenInvert;
int _BlueInvert;
int _AlphaInvert;
float _NormalControlStrength;
int _NormalControlRadius;
int _NormalControlInvert;
int _NormalControlAuthoredOnly;
int _PluginColorSpace;
int _PluginBlend;
int _PluginChannel;
int _PluginMaskMode;
float _PluginOpacity;

float ReadComponent(float4 value, int component)
{
    return component == 0 ? value.r : component == 1 ? value.g : component == 2 ? value.b : value.a;
}

float ApplyPackedInvert(float value, int invert)
{
    return invert != 0 ? 1.0 - value : value;
}

[numthreads(16,16,1)]
void CSExtract(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(id.xy);
    if (any(pixel >= _TextureSize)) return;
    float4 value = _Source.Load(int3(pixel, 0));
    float channel = ReadComponent(value, _Component);
    if (_Invert != 0) channel = 1.0 - channel;
    _Destination[pixel] = float4(channel, channel, channel, 1.0);
}

[numthreads(16,16,1)]
void CSPackChannels(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(id.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    float4 value = _Source.Load(int3(pixel, 0));
    if (_HasRed != 0) value.r = ApplyPackedInvert(ReadComponent(_Red.Load(int3(pixel, 0)), _RedSourceComponent), _RedInvert);
    if (_HasGreen != 0) value.g = ApplyPackedInvert(ReadComponent(_Green.Load(int3(pixel, 0)), _GreenSourceComponent), _GreenInvert);
    if (_HasBlue != 0) value.b = ApplyPackedInvert(ReadComponent(_Blue.Load(int3(pixel, 0)), _BlueSourceComponent), _BlueInvert);
    if (_HasAlpha != 0) value.a = ApplyPackedInvert(ReadComponent(_Alpha.Load(int3(pixel, 0)), _AlphaSourceComponent), _AlphaInvert);
    _Destination[pixel] = value;
}

float4 LoadNormalControl(int2 pixel)
{
    return _NormalControl.Load(int3(clamp(pixel, int2(0, 0), _TextureSize - 1), 0));
}

float ControlHeight(int2 pixel)
{
    float4 value = LoadNormalControl(pixel);
    return _NormalControlAuthoredOnly != 0 ? lerp(0.5, value.r, saturate(value.a)) : value.r;
}

float3 CombineRNM(float3 baseNormal, float3 detailNormal)
{
    float3 t = baseNormal + float3(0.0, 0.0, 1.0);
    float3 u = detailNormal * float3(-1.0, -1.0, 1.0);
    return normalize(t * dot(t, u) / max(t.z, 1e-5) - u);
}

[numthreads(16,16,1)]
void CSApplyNormalControl(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(id.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;

    int radius = clamp(_NormalControlRadius, 1, 16);
    float left = ControlHeight(pixel - int2(radius, 0));
    float right = ControlHeight(pixel + int2(radius, 0));
    float down = ControlHeight(pixel - int2(0, radius));
    float up = ControlHeight(pixel + int2(0, radius));
    float signValue = _NormalControlInvert != 0 ? -1.0 : 1.0;
    float gradientScale = signValue * _NormalControlStrength / max(1.0, 2.0 * radius);
    float2 gradient = float2(right - left, up - down) * gradientScale;
    float3 detailNormal = normalize(float3(-gradient.x, -gradient.y, 1.0));

    float4 encodedBase = _NormalBase.Load(int3(pixel, 0));
    float3 flat = float3(0.0, 0.0, 1.0);
    float3 baseNormal = normalize(encodedBase.rgb * 2.0 - 1.0);
    if (_NormalControlAuthoredOnly != 0)
        baseNormal = normalize(lerp(flat, baseNormal, saturate(encodedBase.a)));
    float3 combined = CombineRNM(baseNormal, detailNormal);

    float alpha = encodedBase.a;
    if (_NormalControlAuthoredOnly != 0)
    {
        alpha = max(alpha, LoadNormalControl(pixel).a);
        alpha = max(alpha, LoadNormalControl(pixel - int2(radius, 0)).a);
        alpha = max(alpha, LoadNormalControl(pixel + int2(radius, 0)).a);
        alpha = max(alpha, LoadNormalControl(pixel - int2(0, radius)).a);
        alpha = max(alpha, LoadNormalControl(pixel + int2(0, radius)).a);
    }
    _Destination[pixel] = float4(combined * 0.5 + 0.5, alpha);
}

float3 PluginSRGBToLinear(float3 value)
{
    float3 low = value / 12.92;
    float3 high = pow(max((value + 0.055) / 1.055, 0.0), 2.4);
    return lerp(low, high, step(0.04045, value));
}

float PluginLuminance(float3 value)
{
    return saturate(dot(value, float3(0.2126, 0.7152, 0.0722)));
}

bool PluginGrayscaleChannel()
{
    return _PluginChannel == 2 || _PluginChannel == 3 || _PluginChannel == 4 ||
        _PluginChannel == 8 || _PluginChannel == 9 || _PluginChannel == 10;
}

[numthreads(16,16,1)]
void CSApplyPluginTile(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(id.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;

    float4 destination = _PluginDestinationSource.Load(int3(pixel, 0));
    float4 source = _PluginSource.Load(int3(id.xy, 0));
    if (_PluginColorSpace == 1) source.rgb = PluginSRGBToLinear(source.rgb);
    float coverage = saturate(_PluginOpacity *
        _GeometryMask.Load(int3(pixel, 0)).r);

    if (_PluginMaskMode != 0)
    {
        float from = PluginLuminance(destination.rgb);
        float value = PluginLuminance(source.rgb);
        float result = _PluginBlend == 2 ? from + value * coverage :
            _PluginBlend == 3 ? lerp(from, from * value, coverage) :
            lerp(from, value, coverage);
        result = saturate(result);
        _Destination[pixel] = float4(result, result, result, 1.0);
        return;
    }

    if (PluginGrayscaleChannel()) source.rgb = PluginLuminance(source.rgb).xxx;
    if (_PluginChannel == 1)
    {
        float3 fromNormal = normalize(destination.rgb * 2.0 - 1.0);
        float3 toNormal = normalize(source.rgb * 2.0 - 1.0);
        float3 normal = normalize(lerp(fromNormal, toNormal, coverage));
        destination = float4(normal * 0.5 + 0.5,
            lerp(destination.a, source.a, coverage));
    }
    else if (_PluginBlend == 0)
        destination = lerp(destination, source, coverage);
    else if (_PluginBlend == 2)
        destination += source * coverage;
    else if (_PluginBlend == 3)
        destination = lerp(destination, destination * source, coverage);
    else
    {
        float alpha = saturate(source.a * coverage);
        destination = float4(lerp(destination.rgb, source.rgb, alpha),
            alpha + destination.a * (1.0 - alpha));
    }

    if (PluginGrayscaleChannel())
    {
        float value = PluginLuminance(destination.rgb);
        destination.rgb = value.xxx;
    }
    _Destination[pixel] = destination;
}
