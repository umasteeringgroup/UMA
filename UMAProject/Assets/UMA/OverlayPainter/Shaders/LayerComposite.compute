#pragma kernel CSCopyBase
#pragma kernel CSCompositeLayer
#pragma kernel CSPrepareEffectSeeds
#pragma kernel CSJumpFloodEffectSeeds
#pragma kernel CSResolveEffectDistance
#pragma kernel CSCompositeLayerEffect
#pragma kernel CSEvaluateLayerMask
#pragma kernel CSApplyGroupMask
#pragma kernel CSApplyIsolatedLayer
#pragma kernel CSUnassociateAlpha
#pragma kernel CSApplyChannelAdjustments
#pragma kernel CSClear

Texture2D<float4> _Base;
Texture2D<float4> _Layer;
Texture2D<float4> _LayerMask;
RWTexture2D<float4> _Composite;
Texture2D<float2> _EffectSeedsRead;
RWTexture2D<float2> _EffectSeedsWrite;
Texture2D<float> _EffectDistanceRead;
RWTexture2D<float> _EffectDistanceWrite;
Texture2D<float4> _EffectCurveTexture;
Texture2D<float4> _AdjustmentCurveTexture;
Texture2D<float4> _EffectTexture1;
Texture2D<float4> _EffectTexture2;
SamplerState sampler_linear_repeat;

Texture2D<float4> _MaskBase;
Texture2D<float4> _MaskOverlay;
RWTexture2D<float4> _MaskResult;
Texture2D<float4> _GroupOriginal;
Texture2D<float4> _GroupResult;
int2 _MaskBaseSize;
int _MaskNoiseEnabled;
int _MaskNoiseSeed;
float2 _MaskNoiseTiling;
float2 _MaskNoiseOffset;
int _MaskNoiseOctaves;
float _MaskNoiseBalance;
float _MaskNoiseContrast;
int _MaskNoiseInvert;
float _MaskNoiseOpacity;
int _MaskNoiseCombine;
int _MaskOverlayEnabled;
int _MaskOverlayChannel;
float2 _MaskOverlayTiling;
float2 _MaskOverlayOffset;
float _MaskOverlayRotation;
int _MaskOverlayInvert;
float _MaskOverlayOpacity;
int _MaskOverlayCombine;
int _HasGroupMask;
float _GroupOpacity;
int _GroupBlendMode;

int2 _TextureSize;
int2 _TileOffset;
int2 _DispatchSize;
float _LayerOpacity;
float _LayerValueScale;
int _BlendMode;
int _HasLayerMask;
int _JumpStep;
int _EffectType;
float4 _EffectColor;
float _EffectWidth;
float _EffectSmoothness;
float2 _EffectOffset;
float _EffectLevel;
float _EffectSaturation;
float _EffectBrightness;
float _EffectContrast;
float _EffectHue;
float _EffectVibrance;
float3 _EffectColorBalance;
int _EffectBlendMode;
int _HasEffectTexture1;
int _HasEffectTexture2;
float2 _EffectTextureTiling1;
float2 _EffectTextureTiling2;
float2 _EffectTextureOffset1;
float2 _EffectTextureOffset2;
float _EffectTextureRotation1;
float _EffectTextureRotation2;
float _EffectTextureOpacity1;
float _EffectTextureOpacity2;
float4 _EffectTextureColor1;
float4 _EffectTextureColor2;
int _EffectTextureBlendMode1;
int _EffectTextureBlendMode2;
int _GrayscaleChannel;

float3 BlendRGB(float3 destination, float3 source, int mode)
{
    if (mode == 1) return destination * source;
    if (mode == 2) return destination + source;
    if (mode == 3) return destination - source;
    if (mode == 4) return 1.0 - (1.0 - destination) * (1.0 - source);
    if (mode == 5)
    {
        float3 low = 2.0 * destination * source;
        float3 high = 1.0 - 2.0 * (1.0 - destination) * (1.0 - source);
        return lerp(low, high, step(0.5, destination));
    }
    return source;
}

float BlendMask(float destination, float source, int mode)
{
    if (mode == 1) return destination * source;
    if (mode == 2) return saturate(destination + source);
    if (mode == 3) return saturate(destination - source);
    if (mode == 4) return 1.0 - (1.0 - destination) * (1.0 - source);
    if (mode == 5)
        return destination < 0.5 ? 2.0 * destination * source
            : 1.0 - 2.0 * (1.0 - destination) * (1.0 - source);
    return source;
}

float MaskHash(float2 value)
{
    value = frac(value * float2(123.34, 456.21));
    value += dot(value, value + 45.32 + _MaskNoiseSeed * 0.0137);
    return frac(value.x * value.y);
}

float MaskValueNoise(float2 position)
{
    float2 cell = floor(position);
    float2 local = frac(position);
    local = local * local * (3.0 - 2.0 * local);
    float a = MaskHash(cell);
    float b = MaskHash(cell + float2(1.0, 0.0));
    float c = MaskHash(cell + float2(0.0, 1.0));
    float d = MaskHash(cell + float2(1.0, 1.0));
    return lerp(lerp(a, b, local.x), lerp(c, d, local.x), local.y);
}

float MaskFbm(float2 position)
{
    float value = 0.0;
    float amplitude = 0.5;
    float total = 0.0;
    [loop] for (int octave = 0; octave < min(_MaskNoiseOctaves, 8); octave++)
    {
        value += MaskValueNoise(position) * amplitude;
        total += amplitude;
        position = position * 2.031 + 17.17;
        amplitude *= 0.5;
    }
    return total > 0.0 ? value / total : 0.0;
}

[numthreads(16, 16, 1)]
void CSEvaluateLayerMask(uint3 dispatchID : SV_DispatchThreadID)
{
    int2 pixel = int2(dispatchID.xy);
    if (any(pixel >= _TextureSize)) return;
    float2 uv = (float2(pixel) + 0.5) / float2(_TextureSize);
    int2 basePixel = clamp(int2(uv * _MaskBaseSize), int2(0, 0), _MaskBaseSize - 1);
    float value = saturate(_MaskBase.Load(int3(basePixel, 0)).r);

    if (_MaskNoiseEnabled != 0)
    {
        float noiseValue = MaskFbm(uv * _MaskNoiseTiling + _MaskNoiseOffset);
        noiseValue = saturate((noiseValue - _MaskNoiseBalance) * _MaskNoiseContrast + 0.5);
        if (_MaskNoiseInvert != 0) noiseValue = 1.0 - noiseValue;
        value = lerp(value, BlendMask(value, noiseValue, _MaskNoiseCombine), _MaskNoiseOpacity);
    }

    if (_MaskOverlayEnabled != 0)
    {
        float angleRadians = radians(_MaskOverlayRotation);
        float sine = sin(angleRadians);
        float cosine = cos(angleRadians);
        float2 centered = uv - 0.5;
        float2 rotated = float2(centered.x * cosine - centered.y * sine,
            centered.x * sine + centered.y * cosine);
        float4 sampleValue = _MaskOverlay.SampleLevel(sampler_linear_repeat,
            rotated * _MaskOverlayTiling + 0.5 + _MaskOverlayOffset, 0);
        float overlayValue = dot(sampleValue.rgb, float3(0.2126, 0.7152, 0.0722));
        if (_MaskOverlayChannel == 1) overlayValue = sampleValue.r;
        else if (_MaskOverlayChannel == 2) overlayValue = sampleValue.g;
        else if (_MaskOverlayChannel == 3) overlayValue = sampleValue.b;
        else if (_MaskOverlayChannel == 4) overlayValue = sampleValue.a;
        if (_MaskOverlayInvert != 0) overlayValue = 1.0 - overlayValue;
        value = lerp(value, BlendMask(value, saturate(overlayValue), _MaskOverlayCombine),
            _MaskOverlayOpacity);
    }
    _MaskResult[pixel] = float4(value, value, value, 1.0);
}

[numthreads(16, 16, 1)]
void CSApplyGroupMask(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    float mask = _HasGroupMask != 0
        ? saturate(_LayerMask.Load(int3(pixel, 0)).r) : 1.0;
    float4 original = _GroupOriginal.Load(int3(pixel, 0));
    float4 result = _GroupResult.Load(int3(pixel, 0));
    float alpha = saturate(result.a * mask * _GroupOpacity);
    // Children are composed against transparent group storage, so RGB is alpha-associated.
    // Recover the straight group color before this group is treated as one source by its parent;
    // otherwise every nested translucent group darkens its descendants one additional time.
    float3 groupColor = result.a > 0.00001 ? result.rgb / result.a : result.rgb;
    float3 blended = BlendRGB(original.rgb, groupColor, _GroupBlendMode);
    _Composite[pixel] = float4(lerp(original.rgb, blended, alpha),
        alpha + original.a * (1.0 - alpha));
}

[numthreads(16, 16, 1)]
void CSApplyIsolatedLayer(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    float4 original = _GroupOriginal.Load(int3(pixel, 0));
    float4 result = _GroupResult.Load(int3(pixel, 0));
    // Normal Control height intensity is authored per layer. Against the ordinary neutral-backed
    // composite, scale only this layer's net change. Authored-only export and isolated groups begin
    // transparent, so recover their straight height, scale it around neutral gray, then associate
    // it again. Alpha coverage remains unchanged in either case.
    if (original.a <= 0.00001 && result.a > 0.00001)
    {
        float3 straightValue = result.rgb / result.a;
        straightValue = 0.5 + (straightValue - 0.5) * _LayerValueScale;
        result.rgb = straightValue * result.a;
    }
    else result.rgb = original.rgb + (result.rgb - original.rgb) * _LayerValueScale;
    _Composite[pixel] = lerp(original, result, saturate(_LayerOpacity));
}

[numthreads(16, 16, 1)]
void CSUnassociateAlpha(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    float4 value = _Composite[pixel];
    value.rgb = value.a > 0.00001 ? value.rgb / value.a : 0.0;
    _Composite[pixel] = value;
}

[numthreads(16, 16, 1)]
void CSClear(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    _Composite[pixel] = float4(0.0, 0.0, 0.0, 0.0);
}

[numthreads(16, 16, 1)]
void CSCopyBase(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    _Composite[pixel] = _Base.Load(int3(pixel, 0));
}

[numthreads(16, 16, 1)]
void CSCompositeLayer(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    float4 destination = _Composite[pixel];
    float4 layer = _Layer.Load(int3(pixel, 0));
    // Texture2D.whiteTexture is only a few texels wide; loading it with destination
    // pixel coordinates returns zero outside that extent. Bypass the load entirely
    // when a layer has no explicit mask.
    float mask = _HasLayerMask != 0 ? _LayerMask.Load(int3(pixel, 0)).r : 1.0;
    float alpha = saturate(layer.a * _LayerOpacity * mask);
    // An isolated group begins transparent. Its first authored layer must remain visible even
    // when that layer uses Multiply/Subtract; transparent pixels have no backdrop to blend with.
    float3 blended = lerp(layer.rgb, BlendRGB(destination.rgb, layer.rgb, _BlendMode),
        step(0.0001, destination.a));
    _Composite[pixel] = float4(lerp(destination.rgb, blended, alpha),
        alpha + destination.a * (1.0 - alpha));
}

float EffectAlphaAt(int2 pixel)
{
    // The destination cannot represent pixels beyond its texture bounds. Clamp edge probes so a
    // layer continuing into an adjacent UDIM tile is not mistaken for terminating against empty
    // space and given a false stroke/shadow along the tile border.
    pixel = clamp(pixel, int2(0, 0), _TextureSize - 1);
    float alpha = _Layer.Load(int3(pixel, 0)).a;
    float mask = _HasLayerMask != 0 ? _LayerMask.Load(int3(pixel, 0)).r : 1.0;
    return saturate(alpha * mask);
}

[numthreads(16, 16, 1)]
void CSPrepareEffectSeeds(uint3 dispatchID : SV_DispatchThreadID)
{
    int2 pixel = int2(dispatchID.xy);
    if (any(pixel >= _TextureSize)) return;
    float alpha = EffectAlphaAt(pixel);
    bool inside = alpha > 0.001;
    // A soft or translucent interior is not itself an edge. Seed only the transition to empty
    // coverage so distance effects retain their falloff instead of becoming a solid fill.
    bool boundary = inside && (
        EffectAlphaAt(pixel + int2(-1, 0)) <= 0.001 ||
        EffectAlphaAt(pixel + int2(1, 0)) <= 0.001 ||
        EffectAlphaAt(pixel + int2(0, -1)) <= 0.001 ||
        EffectAlphaAt(pixel + int2(0, 1)) <= 0.001);
    _EffectSeedsWrite[pixel] = boundary ? float2(pixel) : float2(-1.0, -1.0);
}

[numthreads(16, 16, 1)]
void CSJumpFloodEffectSeeds(uint3 dispatchID : SV_DispatchThreadID)
{
    int2 pixel = int2(dispatchID.xy);
    if (any(pixel >= _TextureSize)) return;
    float2 bestSeed = _EffectSeedsRead.Load(int3(pixel, 0));
    float bestDistanceSquared = bestSeed.x >= 0.0
        ? dot(bestSeed - float2(pixel), bestSeed - float2(pixel)) : 1e30;
    [unroll] for (int y = -1; y <= 1; y++)
    [unroll] for (int x = -1; x <= 1; x++)
    {
        int2 candidatePixel = pixel + int2(x, y) * _JumpStep;
        if (any(candidatePixel < 0) || any(candidatePixel >= _TextureSize)) continue;
        float2 candidateSeed = _EffectSeedsRead.Load(int3(candidatePixel, 0));
        if (candidateSeed.x < 0.0) continue;
        float2 delta = candidateSeed - float2(pixel);
        float candidateDistanceSquared = dot(delta, delta);
        if (candidateDistanceSquared >= bestDistanceSquared) continue;
        bestSeed = candidateSeed;
        bestDistanceSquared = candidateDistanceSquared;
    }
    _EffectSeedsWrite[pixel] = bestSeed;
}

[numthreads(16, 16, 1)]
void CSResolveEffectDistance(uint3 dispatchID : SV_DispatchThreadID)
{
    int2 pixel = int2(dispatchID.xy);
    if (any(pixel >= _TextureSize)) return;
    float2 seed = _EffectSeedsRead.Load(int3(pixel, 0));
    float maximumDistance = length(float2(_TextureSize));
    float distanceToEdge = seed.x >= 0.0 ? length(seed - float2(pixel)) : maximumDistance;
    bool inside = EffectAlphaAt(pixel) > 0.001;
    distanceToEdge = max(0.001, distanceToEdge);
    _EffectDistanceWrite[pixel] = inside ? distanceToEdge : -distanceToEdge;
}

float SampleEffectCurve(float normalizedDistance)
{
    int curvePixel = clamp((int)round(saturate(normalizedDistance) * 255.0), 0, 255);
    return saturate(_EffectCurveTexture.Load(int3(curvePixel, 0, 0)).r);
}

float2 TransformEffectUV(float2 uv, float2 tiling, float2 offset, float rotationDegrees)
{
    float angle = radians(rotationDegrees);
    float sine = sin(angle);
    float cosine = cos(angle);
    float2 centered = uv - 0.5;
    float2 rotated = float2(centered.x * cosine - centered.y * sine,
        centered.x * sine + centered.y * cosine);
    return rotated * tiling + 0.5 + offset;
}

float3 EffectRGBToHSV(float3 color)
{
    float4 k = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = lerp(float4(color.bg, k.wz), float4(color.gb, k.xy), step(color.b, color.g));
    float4 q = lerp(float4(p.xyw, color.r), float4(color.r, p.yzx), step(p.x, color.r));
    float delta = q.x - min(q.w, q.y);
    float epsilon = 1e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * delta + epsilon)),
        delta / (q.x + epsilon), q.x);
}

float3 EffectHSVToRGB(float3 hsv)
{
    float3 p = abs(frac(hsv.xxx + float3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return hsv.z * lerp(float3(1.0, 1.0, 1.0), saturate(p - 1.0), hsv.y);
}

float3 ApplyImageAdjustments(float3 color)
{
    float3 adjusted = color;
    if (_GrayscaleChannel == 0)
    {
        adjusted = saturate(adjusted + _EffectColorBalance);
        float3 hsv = EffectRGBToHSV(saturate(adjusted));
        hsv.x = frac(hsv.x + _EffectHue / 360.0);
        adjusted = EffectHSVToRGB(hsv);
        float luminance = dot(adjusted, float3(0.2126, 0.7152, 0.0722));
        float maximum = max(adjusted.r, max(adjusted.g, adjusted.b));
        float minimum = min(adjusted.r, min(adjusted.g, adjusted.b));
        float chroma = maximum > 0.00001 ? (maximum - minimum) / maximum : 0.0;
        float vibranceScale = 1.0 + (_EffectVibrance >= 0.0
            ? _EffectVibrance * (1.0 - chroma) : _EffectVibrance);
        adjusted = lerp(luminance.xxx, adjusted, vibranceScale);
        adjusted = lerp(luminance.xxx, adjusted, _EffectSaturation);
    }
    else
    {
        adjusted = dot(adjusted, float3(0.2126, 0.7152, 0.0722)).xxx;
    }
    adjusted += _EffectBrightness;
    adjusted = (adjusted - 0.5) * (1.0 + _EffectContrast) + 0.5;
    return saturate(adjusted);
}

float SampleAdjustmentCurve(float grayscaleValue)
{
    int curvePixel = clamp((int)round(saturate(grayscaleValue) * 255.0), 0, 255);
    return saturate(_AdjustmentCurveTexture.Load(int3(curvePixel, 0, 0)).r);
}

[numthreads(16, 16, 1)]
void CSApplyChannelAdjustments(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;
    float4 source = _Layer.Load(int3(pixel, 0));
    float3 adjusted = ApplyImageAdjustments(source.rgb);
    if (_GrayscaleChannel != 0)
    {
        float originalValue = dot(source.rgb, float3(0.2126, 0.7152, 0.0722));
        adjusted = lerp(originalValue.xxx, adjusted, SampleAdjustmentCurve(originalValue));
    }
    _Composite[pixel] = float4(adjusted, source.a);
}

[numthreads(16, 16, 1)]
void CSCompositeLayerEffect(uint3 dispatchID : SV_DispatchThreadID)
{
    if (any(dispatchID.xy >= (uint2)_DispatchSize)) return;
    int2 pixel = int2(dispatchID.xy) + _TileOffset;
    if (any(pixel < 0) || any(pixel >= _TextureSize)) return;

    float sourceAlpha = EffectAlphaAt(pixel);
    if (_EffectType == 10)
    {
        float adjustmentAmount = saturate(_LayerOpacity * _EffectLevel);
        if (sourceAlpha <= 0.00001 || adjustmentAmount <= 0.00001) return;
        float4 destination = _Composite[pixel];
        float3 original = _GroupOriginal.Load(int3(pixel, 0)).rgb;
        // Recover the visible contribution represented by this layer from its already-composited
        // result. Adjusting that contribution, then compositing it back over the untouched
        // backdrop, prevents translucent pixels from applying the adjustment to lower layers.
        float3 isolated = (destination.rgb - original * (1.0 - sourceAlpha)) / sourceAlpha;
        float3 adjusted = ApplyImageAdjustments(isolated);
        float3 adjustedDestination = lerp(original, adjusted, sourceAlpha);
        _Composite[pixel] = float4(lerp(destination.rgb, adjustedDestination, adjustmentAmount),
            destination.a);
        return;
    }
    if (_EffectType == 9)
    {
        float commonCoverage = saturate(sourceAlpha * _LayerOpacity * _EffectLevel);
        if (commonCoverage <= 0.00001 ||
            (_HasEffectTexture1 == 0 && _HasEffectTexture2 == 0)) return;
        float2 uv = (float2(pixel) + 0.5) / float2(_TextureSize);
        float4 destination = _Composite[pixel];
        if (_HasEffectTexture1 != 0)
        {
            float4 sample1 = _EffectTexture1.SampleLevel(
                sampler_linear_repeat, TransformEffectUV(uv, _EffectTextureTiling1,
                    _EffectTextureOffset1, _EffectTextureRotation1), 0);
            float alpha1 = saturate(commonCoverage * _EffectTextureOpacity1 *
                sample1.a * _EffectTextureColor1.a);
            float3 source1 = sample1.rgb * _EffectTextureColor1.rgb;
            if (_GrayscaleChannel != 0) source1 = dot(source1, float3(0.2126, 0.7152, 0.0722)).xxx;
            float3 blended1 = BlendRGB(destination.rgb, source1, _EffectTextureBlendMode1);
            destination = float4(lerp(destination.rgb, blended1, alpha1), destination.a);
        }
        if (_HasEffectTexture2 != 0)
        {
            float4 sample2 = _EffectTexture2.SampleLevel(
                sampler_linear_repeat, TransformEffectUV(uv, _EffectTextureTiling2,
                    _EffectTextureOffset2, _EffectTextureRotation2), 0);
            float alpha2 = saturate(commonCoverage * _EffectTextureOpacity2 *
                sample2.a * _EffectTextureColor2.a);
            float3 source2 = sample2.rgb * _EffectTextureColor2.rgb;
            if (_GrayscaleChannel != 0) source2 = dot(source2, float3(0.2126, 0.7152, 0.0722)).xxx;
            float3 blended2 = BlendRGB(destination.rgb, source2, _EffectTextureBlendMode2);
            destination = float4(lerp(destination.rgb, blended2, alpha2), destination.a);
        }
        _Composite[pixel] = destination;
        return;
    }

    // Shadows use XY translation. Stroke uses X as a signed radial edge offset instead:
    // negative pulls the band into the authored shape, positive pushes it outward.
    int2 shiftedPixel = _EffectType == 0
        ? pixel
        : pixel - int2(round(_EffectOffset));
    float signedDistance = -length(float2(_TextureSize));
    if (all(shiftedPixel >= 0) && all(shiftedPixel < _TextureSize))
        signedDistance = _EffectDistanceRead.Load(int3(shiftedPixel, 0));

    float coverage = 0.0;
    float width = max(0.5, _EffectWidth);
    if (_EffectType == 0)
    {
        float strokeDistance = -signedDistance - _EffectOffset.x;
        if (strokeDistance >= 0.0 && strokeDistance <= width)
        {
            if (_EffectSmoothness <= 0.0001) coverage = 1.0;
            else
            {
                float featherStart = width * (1.0 - saturate(_EffectSmoothness));
                coverage = 1.0 - smoothstep(featherStart, width, strokeDistance);
            }
        }
    }
    else if (_EffectType == 1 || _EffectType == 3)
    {
        if (sourceAlpha > 0.0 && signedDistance >= 0.0)
            coverage = SampleEffectCurve(signedDistance / width);
        coverage *= sourceAlpha;
    }
    else if (_EffectType == 2 || _EffectType == 4)
    {
        if (signedDistance < 0.0) coverage = SampleEffectCurve((-signedDistance) / width);
    }
    else
    {
        coverage = sourceAlpha;
    }

    float alpha = saturate(coverage * _EffectColor.a * _EffectLevel * _LayerOpacity);
    if (alpha <= 0.00001) return;
    float4 destination = _Composite[pixel];
    float3 blended = BlendRGB(destination.rgb, _EffectColor.rgb, _EffectBlendMode);
    if (_GrayscaleChannel != 0) blended = dot(blended, float3(0.2126, 0.7152, 0.0722)).xxx;
    bool clippedEffect = _EffectType == 1 || _EffectType == 3 || _EffectType == 5;
    _Composite[pixel] = float4(lerp(destination.rgb, blended, alpha), clippedEffect
        ? destination.a : alpha + destination.a * (1.0 - alpha));
}
