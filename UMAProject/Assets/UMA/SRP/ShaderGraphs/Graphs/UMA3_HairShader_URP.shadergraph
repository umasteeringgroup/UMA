{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "44d19983d0c745b282befd6c73a40a5c",
    "m_Title": "",
    "m_Content": "We multiply base texture with all 3 colors (Base, Root, Tip) separately and then lerp with a Root/Tip masks. This way we can achieve white tips over the colored hair. We can also disable root&tip colorization and just keep everything with a single Base color.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1868.0,
