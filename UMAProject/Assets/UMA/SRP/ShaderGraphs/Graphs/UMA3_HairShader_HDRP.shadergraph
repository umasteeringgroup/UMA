{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "13f4f26219ae4b1cad90336fc6fe14fd",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "UMA_HairSway (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -250.0,
            "y": -1110.0,
            "width": 260.0,
            "height": 150.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "435cd5400c5247bfb75e97d77070f6fa"
        },
        {
            "m_Id": "282548d634764e26a279c949695d523e"
        },
        {
            "m_Id": "54dff3a925f64a8b83314c881587f856"
        },
        {
            "m_Id": "97c158341f7d4d299356a0e56553cf96"
        },
        {
            "m_Id": "47b24ea30a0b4a8c99f155b07ab42915"
        },
        {
            "m_Id": "533b50f88afc4e05968b6fe1384ace71"
        },
        {
            "m_Id": "930313d30fe14b60b5fe9ef71804b4f2"
        },
        {
            "m_Id": "3b7538a767524c349c6a5ce0eb9eb12d"
        },
        {
            "m_Id": "ad0a32ce3cd648138f400eee7a75ab94"
        },
        {
            "m_Id": "ca07d72306d94d6cad1d41fa28852d33"
        },
        {
            "m_Id": "a67231b933cc41098b8855950ed428ff"
        },
        {
            "m_Id": "af3b5e50883b43829c4d70a74058a654"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UMA_HairSway",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Light sway of the hair, driven by the UMAHairControl component (slots marked Hair Control Ready).\n// Each vertex has a place along its strand, 0 at the scalp and 1 at the tip. Params.w says where it is read:\n// 0 = vertex color (red), 1 = ID Map root channel (red, white at the scalp, so it is turned around),\n// 2 = ID Map tip channel (green). The ID Map is read with the same UVs the root and tip colors use.\n//\n// From Start on, a strand turns about the point where it starts to move: it curves into an arc of a circle that is\n// as long as the straight strand was, and the line from that point to the tip has turned by Angle at full sway.\n// So a tip swings round and comes back a little, as a rotating strand does, and the hair is not pulled longer.\n// Only the part of the sway that goes across the strand turns it; a sway along the strand does nothing.\n// The component measures two things per slot for this: Shape.x, the length of a strand from place 0 to place 1\n// in world units, and Shape.yz, the direction a strand runs in as parts of the tangent and the bitangent.\n//\n// Sway.xyz is the sway in world space (length 0 to 1); Sway.w is the phase of a ripple that runs from scalp to tip.\n// Params = (Start, Angle in radians, Ripple strength, Source). Without the component all are zero and nothing moves.\n// Spin.xyz is the lag of a turning head: hair swings around the head the other way to the turn.\nfloat place = Color.r;\nif (Params.w > 0.5)\n{\n    float4 id = SAMPLE_TEXTURE2D_LOD(IDMap.tex, IDMap.samplerstate, UV.xy, 0);\n    place = Params.w > 1.5 ? id.g : 1.0 - id.r;\n}\nfloat along = saturate((place - Params.x) / max(1.0 - Params.x, 1e-4));\n// The ripple only ever takes movement away, so Angle stays the furthest a strand can turn.\nfloat wave = 1.0 - Params.z * (0.5 - 0.5 * sin(Sway.w - along * 6.2831853));\nfloat3 strand = SafeNormalize(TransformObjectToWorldDir(TangentOS * Shape.y + BitangentOS * Shape.z, false));\n// Turning: each strand is also pushed by how the head turns, sideways around the head, so hair on opposite\n// sides swings opposite ways. Spin.xyz is the turn lag in world space (length 0 to 1). Center is the head.\nfloat3 aroundHead = SafeNormalize(TransformObjectToWorld(PositionOS) - GetCameraRelativePositionWS(Center.xyz)) * saturate(Center.w);\nfloat3 swayWS = Sway.xyz + cross(Spin.xyz, aroundHead);\nfloat swayLength = length(swayWS);\nswayWS = swayLength > 1.0 ? swayWS / swayLength : swayWS;\nfloat3 push = swayWS - strand * dot(swayWS, strand);\nfloat pushLength = length(push);\n// How far along the strand this vertex is from the point the strand turns about.\nfloat reach = along * (1.0 - Params.x) * Shape.x;\n// On an arc, the straight line from its start to a point on it turns in step with the way along the arc, and is\n// shorter than the way along the arc by sin(angle) / angle.\nfloat angle = Params.y * along * wave * pushLength;\nfloat s, c;\nsincos(angle, s, c);\nfloat shorter = angle > 1e-3 ? s / angle : 1.0 - angle * angle / 6.0;\n// Where the vertex ends up, minus where it was. With no angle this is exactly zero, so still hair is not touched.\nfloat3 moveWS = strand * (reach * (shorter * c - 1.0)) + push * (reach * shorter * s / max(pushLength, 1e-5));\nPosition = PositionOS + TransformWorldToObjectDir(moveWS, false);\n"
}

