{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "5b1e7c2d9f0a4e3b8c6d1a2f4e5b7c90",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "UMA_HairRecalcNormalFacing (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -420.0,
            "y": 420.0,
            "width": 260.0,
            "height": 150.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "5b1e7c2d9f0a4e3b8c6d1a2f4e5b7c91"
        },
        {
            "m_Id": "5b1e7c2d9f0a4e3b8c6d1a2f4e5b7c92"
        },
        {
            "m_Id": "5b1e7c2d9f0a4e3b8c6d1a2f4e5b7c93"
        },
        {
            "m_Id": "5b1e7c2d9f0a4e3b8c6d1a2f4e5b7c94"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UMA_HairRecalcNormalFacing",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// On a back face HDRP turns the normal round: it multiplies the vertex normal by _DoubleSidedConstants.z and the\n// normal map's x and y by _DoubleSidedConstants.x (Flip -1,-1,-1; Mirror 1,1,-1; None 1,1,1). Recalculated normals\n// already point out of the hair volume on both sides of a card, so undo that turn for them, whatever the mode:\n// multiplying twice by -1 leaves a value as it was. Without Recalculate Normals HDRP's own turn is what the card needs.\n// Use Double-Sided Normal Mode None with Recalculate Normals: HDRP also turns the geometric normal, and the\n// highlight is dropped where that normal faces away from the camera.\nOut = NormalTS;\nif (Recalculate && !IsFront)\n{\n    Out.xy *= _DoubleSidedConstants.x;\n    Out.z *= _DoubleSidedConstants.z;\n}\n"
}

