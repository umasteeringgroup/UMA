{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "6c2e8b1d4a5f4e7a9b3c0d1e2f3a4b50",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "UMA_HairStrandFromFlow (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1240.0,
            "y": 600.0,
            "width": 240.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "6c2e8b1d4a5f4e7a9b3c0d1e2f3a4b51"
        },
        {
            "m_Id": "6c2e8b1d4a5f4e7a9b3c0d1e2f3a4b52"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UMA_HairStrandFromFlow",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// The flow map stores the strand direction the way a normal map stores a normal: (0.5, 1, 0.5) is a strand\n// along the card's bitangent. HDRP's Hair wants a unit direction in tangent space, from root to tip, which is\n// (0, -1, 0) for a card painted top-down (HDRP's own default); the flow map's (0, 1, 0) points the other way.\n// Read raw, (0.5, 1, 0.5) tilts every strand about 24 degrees out of the card and smears the highlight.\nDirection = -(Flow.rgb * 2.0 - 1.0);\n"
}

