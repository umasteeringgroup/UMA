{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e03",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "UMA_HairHighlightTints (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 160.0,
            "y": 560.0,
            "width": 260.0,
            "height": 220.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e04"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e05"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e06"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e07"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e08"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e09"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e10"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e11"
        },
        {
            "m_Id": "9d4c2b7e1a3f4c6d8e0f1a2b3c4d5e12"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "UMA_HairHighlightTints",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Highlight tints as HDRP's own Hair shader builds them, with the hair's UMA colour in place of its fixed orange.\n// The primary highlight is mostly white with a little of the hair colour; the secondary one (light that passed\n// through the strand) takes the hair colour. Both fade with the strand's alpha, so thin strand edges do not glint.\n// Transmission is shaded by the hair's ambient occlusion and alpha as well.\nfloat a = saturate(Alpha);\nSpecular = SpecularTint * lerp(float3(1.0, 1.0, 1.0), HairColor, 0.3) * a;\nSecondary = SecondaryTint * HairColor * a;\nTransmission = Transmittance * AO * a;\n"
}

