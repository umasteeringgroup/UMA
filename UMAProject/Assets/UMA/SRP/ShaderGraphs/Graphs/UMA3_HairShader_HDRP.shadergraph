    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Mesh center, in object space. By default it is the middle of the renderer bounds, moved by Center Offset.\n// On a skinned character those bounds cover the whole body, so the UMAHairControl component writes\n// the head position (world space, w = 1) into HairCenterWS and that is used instead. Center Offset is left\n// out then: it corrects the bounds center, and the component has an offset of its own.\n// HDRP renders camera-relative: the renderer bounds already are, and the component's head position is turned to match.\nfloat hasCenter = saturate(HairCenterWS.w);\nfloat3 centerWS = lerp((BoundsMin + BoundsMax) * 0.5, GetCameraRelativePositionWS(HairCenterWS.xyz), hasCenter);\nfloat3 centerOS = TransformWorldToObject(centerWS) + CenterOffset * (1.0 - hasCenter);\nfloat3 fromCenter = PositionOS - centerOS;\nfloat dist = length(fromCenter);\n\nNormal = NormalOS;\nTangent = TangentOS;\nif (Recalculate > 0.5)\n{\n    // Point the normal out from the center, so the cards shade as one volume\n    // instead of as separate flat cards facing every way.\n    float3 outward = fromCenter / max(dist, 1e-5);\n    // A card can face the center, so that its back is what you see. Turn its normal to the outer side first:\n    // left as it is, it cancels against the outward direction at a blend near 0.5 and the card goes dark.\n    float3 meshNormal = dot(NormalOS, outward) < 0.0 ? -NormalOS : NormalOS;\n    float3 n = lerp(meshNormal, outward, NormalBlend);\n    Normal = n * rsqrt(max(dot(n, n), 1e-8));\n    // Keep the tangent perpendicular to the new normal (normal map and anisotropy use it).\n    float3 t = TangentOS - Normal * dot(TangentOS, Normal);\n    Tangent = t * rsqrt(max(dot(t, t), 1e-8));\n}\n\n// Cards near the center lie under other cards: darken them a little.\n// Runs per vertex and reaches the fragment stage through the HairShade interpolator.\nfloat outer = saturate((dist - DarkenStart) / max(DarkenEnd - DarkenStart, 1e-5));\nShade = 1.0 - Darken * (1.0 - outer);\n"
}

