    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<b><color=#ffff00>Shared Colors</color></b>\n\n<i>A DynamicCharacterAvatar
    has Shared Colors. These colors are defined in the various recipes (for the base
    race model, as well as any wardrobe items), and used across all items. To add
    a Shared Color, use the Shared Color editor in the recipe editor, then assign
    the shared color to an Overlay in the recipe.\n</i>\n\nIn this sample code:\n\nCurrent
    shared colors are retrieved from the DynamicCharacterAvater using the \"CurrentSharedColors\"
    property in the SampleCode class, in the ColorsClick event handler:\n\n      
    foreach(UMA.OverlayColorData ocd in Avatar.CurrentSharedColors )\n\nThe <b><color=#ffff88>shared
    colors</color></b> are changed in the \"ColorHandler\" class:\n\n        Avatar.SetColor(ColorName,
    ColorValue);\r // this sets a shared color's value on the avatar\n        Avatar.UpdateColors(true);                       
    // This applies the colors to the textures\n\n"
